# ========================================================
# ELMA365 Settings
# ========================================================
ELMA_BASE_URL=https://your-company.elma365.ru
ELMA_API_TOKEN=your_elma_api_token_here

# Optional: Page size and max items to fetch
# ELMA_PAGE_SIZE=100
# ELMA_MAX_ITEMS_FETCH=500

# ========================================================
# Telegram Bot Settings
# ========================================================
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ
TELEGRAM_GROUP_CHAT_ID=-1001234567890
# ID топика (форума) в супергруппе (опционально, если уведомления нужны в конкретную тему)
TELEGRAM_TOPIC_ID=
BOT_USERNAME=your_bot_username

# Прокси для Telegram (если Telegram заблокирован или требуется корпоративный прокси)
# Например: http://proxy.company.local:8080 или socks5://user:pass@host:1080
TELEGRAM_PROXY=

# Проверка SSL (true / false или путь к ca-bundle.crt)
VERIFY_SSL=true

# ========================================================
# Watchdog Settings
# ========================================================
# Интервал проверки очереди (в секундах)
CHECK_INTERVAL_SECONDS=20
# Грейс-период (в минутах) перед алертом о незакрытой сессии
GRACE_PERIOD_MINUTES=10
# Кулдаун повторного алерта по одной и той же сессии (в минутах)
ALERT_COOLDOWN_MINUTES=60

# ========================================================
# Shift Handover (Пересменка)
# ========================================================
# Время отправки отчета о пересменке (через запятую или JSON)
SHIFT_TIMES=08:00, 20:00
# Часовой пояс (смещение в часах, например 5 для UTC+5)
TIMEZONE_OFFSET_HOURS=5

# ========================================================
# Supervisors Whitelist (RBAC)
# ========================================================
# ID пользователей Telegram (числа через запятую)
SUPERVISOR_USER_IDS=12345678, 87654321
# Юзернеймы Telegram (без @ или с @ через запятую)
SUPERVISOR_USERNAMES=supervisor_one, supervisor_two
